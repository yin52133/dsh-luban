{
  "name": "dsh-luban-hud",
  "version": "0.1.0",
  "description": "Concurrent telemetry aggregation and a persistent Web/CLI HUD for DSH",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "luban-hud": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./patch": "./cordis.patch.yml",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node ../../scripts/clean-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-luban-hud/tests"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.1-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yin52133/dsh-luban.git",
    "directory": "packages/dsh-luban-hud"
  },
  "license": "MIT",
  "dependencies": {
    "dsh-luban-core": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-llm": ">=0.1.1-rc.1",
    "@deepseek-ai/dsh-session": ">=0.1.1-rc.1",
    "react": "^18.2.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}

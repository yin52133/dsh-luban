{
  "name": "@yin52133/dsh-luban",
  "version": "0.1.3",
  "description": "Complete DSH Luban plugin suite with pinned companion plugins",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "node ../../scripts/clean-package.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --root ../.. packages/dsh-luban/tests"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.2-rc.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yin52133/dsh-luban.git",
    "directory": "packages/dsh-luban"
  },
  "license": "MIT",
  "dependencies": {
    "@furongjun1999/dsh-memory": "0.4.0",
    "@yin52133/dsh-luban-auth": "workspace:0.1.3",
    "@yin52133/dsh-luban-browser": "workspace:0.1.3",
    "@yin52133/dsh-luban-context": "workspace:0.1.3",
    "@yin52133/dsh-luban-hud": "workspace:0.1.3",
    "@yin52133/dsh-luban-image-paste": "workspace:0.1.3",
    "@yin52133/dsh-luban-keepalive": "workspace:0.1.3",
    "@yin52133/dsh-luban-plan": "workspace:0.1.3",
    "@yin52133/dsh-luban-server-mode": "workspace:0.1.3",
    "@yin52133/dsh-luban-session-share": "workspace:0.1.3",
    "@yin52133/dsh-luban-taskboard": "workspace:0.1.3",
    "@yin52133/dsh-luban-win-debug": "workspace:0.1.3",
    "dsh-better-sidebar": "0.18.0",
    "dshmarket": "1.42.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
